                                        <ansi fg="{{ if gt $speciesInfo.Stats.Mysticism.Base 0  }}cyan-bold{{ else}}234{{end}}">Mys: {{ $speciesInfo.Stats.Mysticism.Base  }}</ansi>{{- `   ` -}}
                                        <ansi fg="{{ if gt $speciesInfo.Stats.Perception.Base 0 }}cyan-bold{{ else}}234{{end}}">Per: {{ $speciesInfo.Stats.Perception.Base }}</ansi>
  <ansi fg="yellow">Buffs:</ansi>       {{if eq (len $speciesInfo.BuffIds) 0}}<ansi fg="234">*None*</ansi>{{end}}{{ range $slotIndex, $buffId := $speciesInfo.BuffIds }}{{if gt $slotIndex 0 }}{{ printf "\n               " }}{{ end }}<ansi fg="buff">{{ buffname $buffId }}</ansi>{{ end }}

