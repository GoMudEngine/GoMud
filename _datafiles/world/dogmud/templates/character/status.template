
 <ansi fg="black-bold">.:</ansi> <ansi fg="username">{{ .Character.Name }}</ansi> the {{ title .Character }}
 ┌─ <ansi fg="black-bold">.:</ansi><ansi fg="20">Attributes</ansi> ──────────────────────────────────────────────────────────────┐
 │ <ansi fg="yellow">Strength:  </ansi>{{ padRight 14 (statQuality .Character.Stats.Strength.Value) }}<ansi fg="yellow">Dexterity: </ansi>{{ padRight 14 (statQuality .Character.Stats.Dexterity.Value) }}<ansi fg="yellow">Perception:</ansi>{{ padRight 14 (statQuality .Character.Stats.Perception.Value) }} │
 │ <ansi fg="yellow">Vitality:  </ansi>{{ padRight 14 (statQuality .Character.Stats.Vitality.Value) }}<ansi fg="yellow">Willpower: </ansi>{{ padRight 14 (statQuality .Character.Stats.Willpower.Value) }}<ansi fg="yellow">Charisma:  </ansi>{{ padRight 14 (statQuality .Character.Stats.Charisma.Value) }} │
 └─────────────────────────────────────────────────────────────────────────────┘
 ┌─ <ansi fg="black-bold">.:</ansi><ansi fg="20">Vitals</ansi> ──────────────────────────────────────────────────────────────────┐
 │ <ansi fg="yellow">Health:    </ansi>{{ vitalQuality .Character.Health .Character.HealthMax.Value 14 }}<ansi fg="yellow">Stamina:   </ansi>{{ vitalQuality .Character.Stamina .Character.StaminaMax.Value 14 }}<ansi fg="yellow">Conviction:</ansi>{{ vitalQuality .Character.Conviction .Character.ConvictionMax.Value 14 }} │
 └─────────────────────────────────────────────────────────────────────────────┘
 ┌─ <ansi fg="black-bold">.:</ansi><ansi fg="20">Defenses</ansi> ────────────────────────────────────────────────────────────────┐
 │ <ansi fg="yellow">Physical:  </ansi>{{ padRight 14 (mitigationQuality (.Character.GetPhysicalMitigation)) }}<ansi fg="yellow">Magical:   </ansi>{{ padRight 14 (mitigationQuality (.Character.GetMagicalMitigation)) }}<ansi fg="yellow">Conviction:</ansi>{{ padRight 14 (mitigationQuality (.Character.GetConvictionMitigation)) }} │
 └─────────────────────────────────────────────────────────────────────────────┘
 ┌─ <ansi fg="black-bold">.:</ansi><ansi fg="20">Info</ansi> ────────────────────────────────────────────────────────────────────┐
 │ <ansi fg="yellow">Species:   </ansi>{{ padRight 25 .Character.Species }}<ansi fg="yellow">Gold:</ansi> {{ padRight 15 (numberFormat .Character.Gold) }}<ansi fg="yellow">Bank:</ansi> {{ padRight 12 (numberFormat .Character.Bank) }} │
 └─────────────────────────────────────────────────────────────────────────────┘
{{- if .Character.Mutations }}
 <ansi fg="black-bold">.:</ansi><ansi fg="20">Mutations</ansi><ansi fg="black-bold">:.</ansi>
{{- range $id, $level := .Character.Mutations }}
   <ansi fg="yellow">{{ printf "%-25s" $id }}</ansi> <ansi fg="magenta">{{ mutationLevel $level }}</ansi>
{{- end }}
{{- end }}
