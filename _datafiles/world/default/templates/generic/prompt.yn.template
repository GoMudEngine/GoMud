<ansi fg="yellow-bold">{{.prompt}}</ansi> <ansi fg="black-bold">[
{{- $default := .default -}}
{{- $length := len .options -}}
{{- $lastIndex := sub $length 1 -}}
{{- range $index, $element := .options -}}
    {{- if or (eq $element "y") (eq $element "yes") -}}
        <ansi fg="green-bold">{{$element}}</ansi>
    {{- else if or (eq $element "n") (eq $element "no") -}}
        <ansi fg="red-bold">{{$element}}</ansi>
    {{- else if eq $element $default -}}
        <ansi fg="white">{{$element}}</ansi>
    {{- else -}}
        <ansi fg="black-bold">{{$element}}</ansi>
    {{- end -}}
    {{- if ne $index $lastIndex -}}
        /
    {{- end -}}
{{- end -}}
]: </ansi>