/_archive/

# Playtest harness overlay — transient run state + generated reports
tools/playtest/.run*/
tools/playtest/.d2.log
tools/playtest/reports/*
!tools/playtest/reports/.gitkeep

# Playtest connection credentials — NEVER commit. Copy targets.example.yaml to
# targets.yaml and fill in real values locally. Untracked 2026-08-08 after an
# audit found live prod creds committed to a public repo.
tools/playtest/targets.yaml
**/targets.yaml
!tools/playtest/targets.example.yaml

# Local build/test artifacts + tool logs
/*.exe
__pycache__/
tools/bridge_run.log
tools/mud_bridge_log.txt

# Claude Code harness local state
.claude/projects/
.claude/scheduled_tasks.lock

# Prod player saves pulled for migration analysis — never commit
_archive/prod-users/
_archive/prod-users.tgz

# Stray screenshots / scratch logs dropped in the repo root. No image or .txt
# file is tracked at the top level any more (they live under docs/images/,
# docs/upstream/ or _archive/), so ignoring the whole root pattern is safe and
# keeps `git status` clean when a screenshot or a redirected boot log lands here.
Screenshot *.png
/*.png
/*.jpg
/*.jpeg
/*.txt

# Compiled binaries + coverage output. `make cover` and the release workflow
# both create bin/ from scratch; nothing in it belongs in the repo.
/bin/

# Moderation living state (petition queue + ban lists) — persist on prod, never commit
_datafiles/world/dogmud/moderation/


# Test-run artifacts: some package tests write relative _datafiles/ paths
# before chdir'ing (e.g. behaviortree crate persistence) — never commit them.
internal/**/_datafiles/
