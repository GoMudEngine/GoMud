      {
        "id": "patrol-loop",
        "label": "Patrol routes",
        "focus": ["patrol-exec", "patrol-yaml", "path-walker"],
        "note": "A mob carries patrol_id for an always-on loop, or a schedule segment opts in with activity: patrol for part of the day."
      },
      {
        "id": "npc-talk",
        "label": "NPCs talking to each other",
        "focus": ["conversation", "conv-yaml", "relationships"],
        "note": "Only authored relationship pairs talk, only while both are fully idle, one line per round, then a shared cooldown."
      },
      {
        "id": "interrupts",
        "label": "What breaks the routine",
        "focus": ["combat-gate", "sweep", "patrol-exec"],
        "note": "Combat skips the whole idle body. The patrol waypoint index lives in MiscData, so the loop resumes at the same target."
      }
