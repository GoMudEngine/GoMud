    },
    "views": [
      {
        "id": "connection-path",
        "label": "How a player connects",
        "focus": ["telnet-players", "web-players", "telnet-listener", "web-server", "conn-pipeline"],
        "note": "Telnet sockets and upgraded websockets become the same ConnectionDetails, then run the same input-handler chain."
      },
      {
        "id": "the-tick",
        "label": "The world tick",
        "focus": ["conn-pipeline", "tick", "rooms", "mobs"],
        "note": "A submitted line becomes an Input event. MainWorker drains the queue every millisecond and fires a turn every 50 ms."
      },
      {
        "id": "world-state",
        "label": "Live world state",
        "focus": ["tick", "rooms", "mobs", "users"],
        "note": "Rooms, mobs and characters are plain in-memory Go structs, mutated only under the single world lock the tick holds."
      },
      {
        "id": "data-layer",
        "label": "Where the world is authored",
        "focus": ["world-yaml", "instances", "rooms", "mobs"],
        "note": "Every room, mob, item and quest is hand-authored YAML. The template always loads; an instance save is layered on top only if one exists."
      },
      {
        "id": "modules",
        "label": "Pluggable modules",
        "focus": ["tick", "modules", "conn-pipeline", "web-server"],
        "note": "Modules are compiled in and attach purely through event listeners. GMCP is the one that feeds the browser client."
      }
    ]
  },
