  "meta": {
    "title": "DOGMud Engine Overview",
    "subtitle": "A Go MUD engine with a YAML-authored world",
    "output": "engine-overview.html",
    "quality_profile": "showcase",
    "repository": {
      "url": "https://github.com/pruuk/DOGMud",
